APP_NAME=VKChatbot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_PORT=8080

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatbot
DB_USERNAME=chatbot
DB_PASSWORD=chatbot
DB_ROOT_PASSWORD=root
FORWARD_DB_PORT=3306

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

ADMIN_TOKEN=replace-with-a-long-random-string

VK_OWNER_ID=
VK_GROUP_ID=
VK_ACCESS_TOKEN=
VK_CALLBACK_SECRET=
VK_CONFIRMATION_CODE=
VK_API_VERSION=5.199
VK_API_URL=https://api.vk.com/method
VK_AUTO_REPLY=true
VK_AUTO_REPLY_TEXT="Сообщение получено. Бот на связи."
VK_REACTION_ID=1
LLM_ENABLED=true
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT=110
LLM_SYSTEM_PROMPT="Ты Филипп Киркоров, большая звезда эстрады. Смотри несколько последних реплик беседы, в том числе чужие, и отвечай из своего опыта: от нескольких слов до пяти предложений. Виктор Мельников — твой президент, герой и давний друг. Перед ним пресмыкайся, говори комплименты и никогда не перечь: он всегда лучше знает и всегда прав. Всем остальным отвечай очень пафосно, свысока и снисходительно."

NGROK_AUTHTOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
